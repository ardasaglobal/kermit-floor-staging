{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "account_id": "91bdb37d47afe3e4ed30103d59880dc5",
  "routes": [
    {"pattern": "kermitfloor.ro", "custom_domain": true},
    {"pattern": "www.kermitfloor.ro", "custom_domain": true}
  ],
  "main": ".open-next/worker.js",
  "name": "kermit-floor-ro",
  "compatibility_date": "2025-05-05",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "CATALOGUE_FILES",
      "bucket_name": "kermit-floor-downloads"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "kermit-floor-ro"
    }
  ],
  "images": {
    "binding": "IMAGES"
  }
}
